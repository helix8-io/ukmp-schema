{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.materialspassport.org.uk/v0.1/material_passport.schema.json",
  "title": "UK Materials Passport (ukmp:MaterialPassport) v0.1",
  "description": "Validation schema for the credentialSubject of a UK Materials Passport. WP1 deliverable D1.2, project 10188380. Draft for steering review.",
  "type": "object",
  "required": ["type", "passportId", "subjectType", "issuerParty", "issueDate", "composition", "recycledContent"],
  "properties": {
    "type": { "const": "ukmp:MaterialPassport" },
    "passportId": { "type": "string", "format": "uri" },
    "subjectType": { "enum": ["MaterialBatch", "Product", "Component"] },
    "gs1:gtin": { "type": "string", "pattern": "^[0-9]{8,14}$" },
    "gs1:lgtin": { "type": "string" },
    "alternativeId": {
      "type": "object",
      "required": ["scheme", "value"],
      "properties": { "scheme": { "type": "string" }, "value": { "type": "string" } }
    },
    "sectorProfile": { "type": "string", "format": "uri" },
    "conformanceLevel": { "enum": [1, 2, 3] },
    "issuerParty": { "$ref": "#/$defs/party" },
    "issueDate": { "type": "string", "format": "date" },
    "lastUpdated": { "type": "string", "format": "date-time" },
    "description": { "type": "string" },
    "composition": { "$ref": "#/$defs/composition" },
    "recycledContent": { "$ref": "#/$defs/recycledContentClaim" },
    "processingHistory": { "$ref": "#/$defs/processingHistory" },
    "environmentalFootprint": { "$ref": "#/$defs/lcaSummary" },
    "ukRegulatory": { "$ref": "#/$defs/ukRegulatoryData" }
  },
  "anyOf": [
    { "required": ["gs1:gtin"] },
    { "required": ["gs1:lgtin"] },
    { "required": ["alternativeId"] }
  ],
  "$defs": {
    "party": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "gs1:gln": { "type": "string", "pattern": "^[0-9]{13}$" },
        "role": { "enum": ["producer", "collector", "sorter", "reprocessor", "compounder", "converter", "manufacturer", "brand", "verifier", "other"] }
      }
    },
    "composition": {
      "type": "object",
      "required": ["materialFamily", "substances"],
      "properties": {
        "materialFamily": { "enum": ["polymer", "metal", "glass", "fibre", "mineral", "composite", "other"] },
        "substances": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "massFraction"],
            "properties": {
              "name": { "type": "string" },
              "casNumber": { "type": "string" },
              "ecNumber": { "type": "string" },
              "massFraction": { "type": "number", "minimum": 0, "maximum": 1 },
              "svhcFlag": { "type": "boolean" }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "recycledContentClaim": {
      "type": "object",
      "required": ["totalRecycledFraction", "calculationMethod", "evidenceType", "verificationStatus"],
      "properties": {
        "preConsumerFraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "postConsumerFraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "totalRecycledFraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "calculationMethod": { "enum": ["mass-balance", "batch-segregation", "controlled-blending", "declared"] },
        "chainOfCustodyModel": { "enum": ["identity-preserved", "segregated", "mass-balance", "book-and-claim"] },
        "evidenceType": { "enum": ["epcis-event-chain", "third-party-certificate", "supplier-declaration"] },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "format": "uri-reference" } },
        "verificationStatus": { "enum": ["self-declared", "evidence-linked", "independently-verified"] },
        "verifierParty": { "$ref": "#/$defs/party" }
      },
      "allOf": [
        {
          "if": { "properties": { "verificationStatus": { "const": "independently-verified" } } },
          "then": { "required": ["verifierParty"] }
        },
        {
          "if": { "properties": { "evidenceType": { "const": "epcis-event-chain" } } },
          "then": { "required": ["evidenceRefs"] }
        }
      ]
    },
    "processingHistory": {
      "type": "object",
      "required": ["epcisEvents"],
      "properties": {
        "epcisEvents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["eventID", "type", "bizStep", "eventTime"],
            "properties": {
              "eventID": { "type": "string" },
              "type": { "enum": ["ObjectEvent", "TransformationEvent", "AggregationEvent", "AssociationEvent"] },
              "bizStep": { "type": "string" },
              "eventTime": { "type": "string", "format": "date-time" },
              "ukmp:massBalanceDelta": {
                "type": "object",
                "required": ["inputKg", "outputKg"],
                "properties": {
                  "inputKg": { "type": "number", "minimum": 0 },
                  "outputKg": { "type": "number", "minimum": 0 },
                  "wasteKg": { "type": "number", "minimum": 0 }
                }
              },
              "ukmp:verificationExtension": {
                "type": "object",
                "properties": {
                  "instrument": { "type": "string" },
                  "measuredPolymerClass": { "type": "string" },
                  "contaminationLevel": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            },
            "additionalProperties": true
          }
        },
        "traversable": { "type": "boolean" }
      }
    },
    "lcaSummary": {
      "type": "object",
      "required": ["carbonFootprintKgCo2ePerKg", "assessmentBoundary", "methodology"],
      "properties": {
        "carbonFootprintKgCo2ePerKg": { "type": "number", "minimum": 0 },
        "assessmentBoundary": { "enum": ["cradle-to-gate", "gate-to-gate", "cradle-to-grave"] },
        "methodology": { "type": "string" },
        "dataQualityRating": { "type": "integer", "minimum": 1, "maximum": 5 },
        "primaryDataFraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "energySource": {
          "type": "object",
          "properties": {
            "gridKwh": { "type": "number", "minimum": 0 },
            "onSiteRenewablesKwh": { "type": "number", "minimum": 0 }
          }
        },
        "virginBaselineKgCo2ePerKg": {
          "type": "object",
          "required": ["value", "source"],
          "properties": {
            "value": { "type": "number", "minimum": 0 },
            "unit": { "type": "string" },
            "source": { "type": "string" },
            "assessmentBoundary": { "enum": ["cradle-to-gate", "gate-to-gate", "cradle-to-grave"] }
          }
        },
        "netAvoidedKgCo2ePerKg": { "type": "number" }
      }
    },
    "ukRegulatoryData": {
      "type": "object",
      "properties": {
        "ewcCode": { "type": "string", "pattern": "^[0-9]{2} [0-9]{2} [0-9]{2}\\*?$" },
        "endOfWasteStatus": {
          "type": "object",
          "required": ["achieved"],
          "properties": {
            "achieved": { "type": "boolean" },
            "basis": { "enum": ["quality-protocol", "individual-assessment", "not-applicable"] },
            "atEvent": { "type": "string" }
          }
        },
        "wasteHierarchyPosition": { "enum": ["preparation-for-reuse", "recycling", "recovery"] },
        "recoveryCode": { "type": "string", "pattern": "^R[0-9]{1,2}$" },
        "pptStatus": {
          "type": "object",
          "required": ["inScope"],
          "properties": {
            "inScope": { "type": "boolean" },
            "recycledFractionForPpt": { "type": "number", "minimum": 0, "maximum": 1 },
            "evidenceRef": { "type": "string" }
          }
        },
        "eprCategory": { "type": "string" },
        "permits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "ref"],
            "properties": { "type": { "type": "string" }, "ref": { "type": "string" } }
          }
        },
        "euMapping": {
          "type": "object",
          "properties": {
            "esprCategory": { "type": "string" },
            "ppwrRecyclabilityGrade": { "type": "string" }
          }
        }
      }
    }
  }
}
