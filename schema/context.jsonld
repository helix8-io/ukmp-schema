{
  "@context": {
    "@version": 1.1,
    "@protected": true,

    "ukmp": "https://schema.materialspassport.org.uk/v0.1/",
    "gs1": "https://gs1.org/voc/",
    "cred": "https://www.w3.org/2018/credentials#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "MaterialPassportCredential": "ukmp:MaterialPassportCredential",

    "MaterialPassport": {
      "@id": "ukmp:MaterialPassport",
      "@context": {
        "@version": 1.1,
        "@protected": true,

        "passportId": { "@id": "ukmp:passportId", "@type": "@id" },
        "subjectType": "ukmp:subjectType",
        "alternativeId": { "@id": "ukmp:alternativeId", "@type": "@id" },
        "sectorProfile": { "@id": "ukmp:sectorProfile", "@type": "@id" },
        "conformanceLevel": { "@id": "ukmp:conformanceLevel", "@type": "xsd:integer" },
        "issuerParty": { "@id": "ukmp:issuerParty", "@type": "@id" },
        "issueDate": { "@id": "ukmp:issueDate", "@type": "xsd:date" },
        "lastUpdated": { "@id": "ukmp:lastUpdated", "@type": "xsd:dateTime" },
        "composition": { "@id": "ukmp:composition", "@type": "@id" },
        "recycledContent": { "@id": "ukmp:recycledContent", "@type": "@id" },
        "processingHistory": { "@id": "ukmp:processingHistory", "@type": "@id" },
        "environmentalFootprint": { "@id": "ukmp:environmentalFootprint", "@type": "@id" },
        "ukRegulatory": { "@id": "ukmp:ukRegulatory", "@type": "@id" }
      }
    },

    "passportId": { "@id": "ukmp:passportId", "@type": "@id" },
    "subjectType": "ukmp:subjectType",
    "alternativeId": { "@id": "ukmp:alternativeId", "@type": "@id" },
    "sectorProfile": { "@id": "ukmp:sectorProfile", "@type": "@id" },
    "conformanceLevel": { "@id": "ukmp:conformanceLevel", "@type": "xsd:integer" },
    "issuerParty": { "@id": "ukmp:issuerParty", "@type": "@id" },
    "issueDate": { "@id": "ukmp:issueDate", "@type": "xsd:date" },
    "lastUpdated": { "@id": "ukmp:lastUpdated", "@type": "xsd:dateTime" },
    "composition": { "@id": "ukmp:composition", "@type": "@id" },
    "recycledContent": { "@id": "ukmp:recycledContent", "@type": "@id" },
    "processingHistory": { "@id": "ukmp:processingHistory", "@type": "@id" },
    "environmentalFootprint": { "@id": "ukmp:environmentalFootprint", "@type": "@id" },
    "ukRegulatory": { "@id": "ukmp:ukRegulatory", "@type": "@id" },

    "identityLevel": "https://schema.materialspassport.org.uk/v0.2/identityLevel",
    "productTypeRef": { "@id": "https://schema.materialspassport.org.uk/v0.2/productTypeRef", "@type": "@id" },
    "aggregation": {
      "@id": "https://schema.materialspassport.org.uk/v0.2/aggregation",
      "@context": {
        "parentRefs": { "@id": "https://schema.materialspassport.org.uk/v0.2/parentRefs", "@type": "@id", "@container": "@set" },
        "childRefs": { "@id": "https://schema.materialspassport.org.uk/v0.2/childRefs", "@type": "@id", "@container": "@set" }
      }
    },
    "lifecycle": {
      "@id": "https://schema.materialspassport.org.uk/v0.2/lifecycle",
      "@context": {
        "status": "https://schema.materialspassport.org.uk/v0.2/lifecycleStatus",
        "predecessorRefs": { "@id": "https://schema.materialspassport.org.uk/v0.2/predecessorRefs", "@type": "@id", "@container": "@set" },
        "successorRefs": { "@id": "https://schema.materialspassport.org.uk/v0.2/successorRefs", "@type": "@id", "@container": "@set" },
        "statusChangedAt": { "@id": "https://schema.materialspassport.org.uk/v0.2/statusChangedAt", "@type": "xsd:dateTime" }
      }
    },
    "accessPolicy": {
      "@id": "https://schema.materialspassport.org.uk/v0.2/accessPolicy",
      "@context": {
        "defaultTier": "https://schema.materialspassport.org.uk/v0.2/defaultTier",
        "fieldTiers": {
          "@id": "https://schema.materialspassport.org.uk/v0.2/fieldTiers",
          "@container": "@set",
          "@context": {
            "path": "https://schema.materialspassport.org.uk/v0.2/path",
            "tier": "https://schema.materialspassport.org.uk/v0.2/tier"
          }
        }
      }
    },
    "fieldStatus": {
      "@id": "https://schema.materialspassport.org.uk/v0.2/fieldStatus",
      "@container": "@set",
      "@context": {
        "path": "https://schema.materialspassport.org.uk/v0.2/path",
        "status": "https://schema.materialspassport.org.uk/v0.2/applicabilityStatus",
        "basis": "https://schema.materialspassport.org.uk/v0.2/applicabilityBasis",
        "reviewBy": { "@id": "https://schema.materialspassport.org.uk/v0.2/reviewBy", "@type": "xsd:date" }
      }
    },

    "Party": "ukmp:Party",
    "role": "ukmp:role",
    "parties": { "@id": "https://schema.materialspassport.org.uk/v0.2/parties", "@container": "@set" },
    "address": {
      "@id": "https://schema.materialspassport.org.uk/v0.2/address",
      "@context": {
        "streetAddress": "https://schema.materialspassport.org.uk/v0.2/streetAddress",
        "locality": "https://schema.materialspassport.org.uk/v0.2/locality",
        "region": "https://schema.materialspassport.org.uk/v0.2/region",
        "postalCode": "https://schema.materialspassport.org.uk/v0.2/postalCode",
        "countryCode": "https://schema.materialspassport.org.uk/v0.2/countryCode"
      }
    },
    "contactPoint": {
      "@id": "https://schema.materialspassport.org.uk/v0.2/contactPoint",
      "@context": {
        "email": "https://schema.materialspassport.org.uk/v0.2/email",
        "telephone": "https://schema.materialspassport.org.uk/v0.2/telephone",
        "url": { "@id": "https://schema.materialspassport.org.uk/v0.2/url", "@type": "@id" }
      }
    },
    "scheme": "ukmp:scheme",
    "value": "ukmp:value",

    "Composition": "ukmp:Composition",
    "materialFamily": "ukmp:materialFamily",
    "substances": { "@id": "ukmp:substances", "@container": "@set" },
    "casNumber": "ukmp:casNumber",
    "ecNumber": "ukmp:ecNumber",
    "massFraction": { "@id": "ukmp:massFraction", "@type": "xsd:decimal" },
    "svhcFlag": { "@id": "ukmp:svhcFlag", "@type": "xsd:boolean" },

    "RecycledContentClaim": "ukmp:RecycledContentClaim",
    "preConsumerFraction": { "@id": "ukmp:preConsumerFraction", "@type": "xsd:decimal" },
    "postConsumerFraction": { "@id": "ukmp:postConsumerFraction", "@type": "xsd:decimal" },
    "totalRecycledFraction": { "@id": "ukmp:totalRecycledFraction", "@type": "xsd:decimal" },
    "calculationMethod": "ukmp:calculationMethod",
    "chainOfCustodyModel": "ukmp:chainOfCustodyModel",
    "evidenceType": "ukmp:evidenceType",
    "evidenceRefs": { "@id": "ukmp:evidenceRefs", "@type": "@id", "@container": "@set" },
    "verificationStatus": "ukmp:verificationStatus",
    "verifierParty": { "@id": "ukmp:verifierParty", "@type": "@id" },
    "feedstockSource": "https://schema.materialspassport.org.uk/v0.2/feedstockSource",

    "epcisEvents": { "@id": "ukmp:epcisEvents", "@container": "@list" },
    "traversable": { "@id": "ukmp:traversable", "@type": "xsd:boolean" },
    "eventID": { "@id": "ukmp:eventID", "@type": "@id" },
    "bizStep": "ukmp:bizStep",
    "eventTime": { "@id": "ukmp:eventTime", "@type": "xsd:dateTime" },
    "ukmp:massBalanceDelta": {
      "@id": "ukmp:massBalanceDelta",
      "@context": {
        "inputKg": { "@id": "ukmp:inputKg", "@type": "xsd:decimal" },
        "outputKg": { "@id": "ukmp:outputKg", "@type": "xsd:decimal" },
        "wasteKg": { "@id": "ukmp:wasteKg", "@type": "xsd:decimal" }
      }
    },
    "ukmp:verificationExtension": {
      "@id": "ukmp:verificationExtension",
      "@context": {
        "instrument": "ukmp:instrument",
        "measuredPolymerClass": "ukmp:measuredPolymerClass",
        "contaminationLevel": { "@id": "ukmp:contaminationLevel", "@type": "xsd:decimal" }
      }
    },

    "LcaSummary": "ukmp:LcaSummary",
    "carbonFootprintKgCo2ePerKg": { "@id": "ukmp:carbonFootprintKgCo2ePerKg", "@type": "xsd:decimal" },
    "assessmentBoundary": "ukmp:assessmentBoundary",
    "methodology": "ukmp:methodology",
    "characterisationFactors": "ukmp:characterisationFactors",
    "dataQualityRating": { "@id": "ukmp:dataQualityRating", "@type": "xsd:integer" },
    "primaryDataFraction": { "@id": "ukmp:primaryDataFraction", "@type": "xsd:decimal" },
    "energySource": { "@id": "ukmp:energySource", "@type": "@id" },
    "gridKwh": { "@id": "ukmp:gridKwh", "@type": "xsd:decimal" },
    "onSiteRenewablesKwh": { "@id": "ukmp:onSiteRenewablesKwh", "@type": "xsd:decimal" },
    "virginDisplacementFactor": { "@id": "ukmp:virginDisplacementFactor", "@type": "@id" },
    "unit": "ukmp:unit",
    "source": "ukmp:source",
    "declaredUnit": {
      "@id": "https://schema.materialspassport.org.uk/v0.2/declaredUnit",
      "@context": {
        "quantity": { "@id": "https://schema.materialspassport.org.uk/v0.2/quantity", "@type": "xsd:decimal" },
        "description": "https://schema.materialspassport.org.uk/v0.2/declaredUnitDescription"
      }
    },
    "carbonFootprintPerDeclaredUnit": { "@id": "https://schema.materialspassport.org.uk/v0.2/carbonFootprintPerDeclaredUnit", "@type": "xsd:decimal" },
    "indicators": {
      "@id": "https://schema.materialspassport.org.uk/v0.2/indicators",
      "@container": "@set",
      "@context": {
        "indicator": "https://schema.materialspassport.org.uk/v0.2/indicator",
        "lifecycleStage": "https://schema.materialspassport.org.uk/v0.2/lifecycleStage",
        "value": { "@id": "https://schema.materialspassport.org.uk/v0.2/indicatorValue", "@type": "xsd:decimal" }
      }
    },
    "studyRefs": { "@id": "https://schema.materialspassport.org.uk/v0.2/studyRefs", "@type": "@id", "@container": "@set" },
    "recycledContentDetail": {
      "@id": "https://schema.materialspassport.org.uk/v0.2/recycledContentDetail",
      "@container": "@set",
      "@context": {
        "scope": {
          "@id": "https://schema.materialspassport.org.uk/v0.2/scope",
          "@context": {
            "material": "https://schema.materialspassport.org.uk/v0.2/scopeMaterial",
            "componentRef": "https://schema.materialspassport.org.uk/v0.2/componentRef",
            "layer": "https://schema.materialspassport.org.uk/v0.2/layer"
          }
        }
      }
    },

    "UkRegulatoryData": "ukmp:UkRegulatoryData",
    "ewcCode": "ukmp:ewcCode",
    "endOfWasteStatus": { "@id": "ukmp:endOfWasteStatus", "@type": "@id" },
    "achieved": { "@id": "ukmp:achieved", "@type": "xsd:boolean" },
    "basis": "ukmp:basis",
    "atEvent": { "@id": "ukmp:atEvent", "@type": "@id" },
    "wasteHierarchyPosition": "ukmp:wasteHierarchyPosition",
    "recoveryCode": "ukmp:recoveryCode",
    "pptStatus": { "@id": "ukmp:pptStatus", "@type": "@id" },
    "inScope": { "@id": "ukmp:inScope", "@type": "xsd:boolean" },
    "recycledFractionForPpt": { "@id": "ukmp:recycledFractionForPpt", "@type": "xsd:decimal" },
    "evidenceRef": { "@id": "ukmp:evidenceRef", "@type": "@id" },
    "eprCategory": "ukmp:eprCategory",
    "permits": { "@id": "ukmp:permits", "@container": "@set" },
    "ref": "ukmp:ref",
    "euMapping": { "@id": "ukmp:euMapping", "@type": "@id" },
    "esprCategory": "ukmp:esprCategory",
    "ppwrRecyclabilityGrade": "ukmp:ppwrRecyclabilityGrade"
  }
}
